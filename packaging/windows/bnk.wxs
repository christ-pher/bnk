<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI for the bnk Windows client.

  It installs files and puts them on PATH. Configuration — which server,
  which enrollment key, which operator account — is not baked into the
  package: it is applied by `bnk service install`, the same code path the
  script installer uses, so there is one implementation of that logic
  rather than two.

  Pass BNK_SERVER (and usually BNK_KEY) to have the package register and
  start the service itself:

    msiexec /i bnk.msi /qn BNK_SERVER=https://host:8443 BNK_KEY=bnkkey:...

  With no BNK_SERVER the install is files-only, which is the right
  behaviour for an upgrade: the service is already configured, and the
  UpgradeCode below means its settings survive.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="bnk"
           Manufacturer="bnk"
           Version="$(var.Version)"
           UpgradeCode="6f1d9b02-3a4c-4f5e-9c11-2b7a5d4e8f30"
           Scope="perMachine"
           Compressed="yes">

    <!-- Replace an older install in place instead of stacking entries
         in Add or Remove Programs. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of bnk is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="bnkicon" SourceFile="connected.ico" />
    <Property Id="ARPPRODUCTICON" Value="bnkicon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/christ-pher/bnk" />

    <Property Id="BNK_SERVER" Secure="yes" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="bnk is installed and connecting. The tray icon controls it."
                 After="AppSearch" Condition="BNK_SERVER" Sequence="first" />
    <Property Id="BNK_KEY" Secure="yes" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- The minimal wizard has nowhere to ask for a server and key, so a
         double-click installs files only. Say so on the last page
         instead of leaving the user with nothing running. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="bnk is installed and running. Open it from the Start menu, then choose Sign in and paste the join command from your server." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="bnk" />
    </StandardDirectory>

    <!-- Without a Start Menu entry the tray is unreachable except from a
         command line: Windows Search only indexes shortcuts, not files
         in Program Files. -->
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="Binaries" Directory="INSTALLFOLDER">
      <Component Id="bnkExe" Guid="*">
        <File Id="bnkExe" Source="bnk.exe" KeyPath="yes" />
        <!-- One PATH entry for the whole package, so `bnk` works from
             any shell without the script installer's manual edit. -->
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
      <Component Id="bnkTrayExe" Guid="*">
        <!-- The shortcut lives with the file it points at, so the file
             is the component's keypath. A separate component would need
             one of its own, and a registry keypath under HKCU is wrong
             in a per-machine package. It is named "bnk" because the tray
             is what someone means when they go looking for this. -->
        <File Id="bnkTrayExe" Source="bnk-tray.exe" KeyPath="yes">
          <Shortcut Id="TrayShortcut" Directory="ProgramMenuFolder" Name="bnk"
                    Description="Open the bnk tray: connect, disconnect, and see the mesh"
                    WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>
      </Component>
      <Component Id="wintunDll" Guid="*">
        <File Id="wintunDll" Source="wintun.dll" KeyPath="yes" />
      </Component>
      <Component Id="wintunLicense" Guid="*">
        <File Id="wintunLicense" Source="WINTUN-LICENSE.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="bnk" Level="1">
      <ComponentGroupRef Id="Binaries" />
    </Feature>

    <!-- Registration runs deferred and elevated, after the files exist.
         Uninstall reverses it before they are removed. -->
    <CustomAction Id="SetRegisterCmd"
                  Property="RegisterService"
                  Value="&quot;[INSTALLFOLDER]bnk.exe&quot; service install --server &quot;[BNK_SERVER]&quot; --key &quot;[BNK_KEY]&quot; --operator &quot;[USERDOMAIN]\[LogonUser]&quot; --start" />
    <CustomAction Id="RegisterService"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred" Return="check" Impersonate="no" />

    <CustomAction Id="SetUnregisterCmd"
                  Property="UnregisterService"
                  Value="&quot;[INSTALLFOLDER]bnk.exe&quot; service uninstall" />
    <!-- Return="ignore": a machine with nothing registered must still
         uninstall cleanly. The action stops the service and the tray,
         which is what frees the files for removal. -->
    <CustomAction Id="UnregisterService"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- Launch the tray as the installing user. This runs immediate and
         impersonated on purpose: a deferred action runs as SYSTEM, whose
         windows never appear in the user's session. -->
    <CustomAction Id="LaunchTray" FileRef="bnkTrayExe" ExeCommand=""
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <!-- NOT REMOVE: install, repair, and upgrade register the
           service; uninstall must not, or it runs `service install`
           against files it is in the middle of deleting and fails the
           removal. Dropping the old BNK_SERVER condition to make the
           service always install is what exposed this. -->
      <Custom Action="SetRegisterCmd" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RegisterService" After="SetRegisterCmd" Condition="NOT REMOVE" />
      <Custom Action="SetUnregisterCmd" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UnregisterService" After="SetUnregisterCmd" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="LaunchTray" After="InstallFinalize" Condition="NOT Installed OR REINSTALL" />
    </InstallExecuteSequence>
  </Package>
</Wix>
