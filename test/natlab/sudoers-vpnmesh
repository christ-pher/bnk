# Passwordless sudo for the vpnmesh root-required test scripts, so the
# development loop (including Claude Code sessions) can run them directly.
#
# Install:  sudo cp test/natlab/sudoers-vpnmesh /etc/sudoers.d/vpnmesh && sudo chmod 440 /etc/sudoers.d/vpnmesh
# Remove:   sudo rm /etc/sudoers.d/vpnmesh
#
# Honest security note: these scripts live in a chris-writable repo, so
# this grant is equivalent to passwordless root for anything running as
# chris on this machine. Fine for a personal dev box you already treat
# that way; remove it if that ever changes.
chris ALL=(root) NOPASSWD: /home/chris/projects/vpn/test/natlab/punch.sh
chris ALL=(root) NOPASSWD: /home/chris/projects/vpn/test/natlab/punch.sh *
chris ALL=(root) NOPASSWD: /home/chris/projects/vpn/test/e2e/smoke.sh
